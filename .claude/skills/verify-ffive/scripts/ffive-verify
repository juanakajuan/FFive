#!/bin/bash
# Drives FFive on a dedicated, throwaway iOS simulator. See ../SKILL.md for the workflow.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
skill="$(dirname "$here")"
root="$(git -C "$here" rev-parse --show-toplevel)"
work="$root/.verify"
state="$work/state.env"
artifacts="$work/artifacts"
app_build="$work/build"
driver_build="$work/build-driver"
bundle_id="com.juanix.FFive"
device_type="${FFIVE_DEVICE_TYPE:-com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro}"
# One simulator per checkout, so worktrees never share a device or its data.
device_name="FFive Verify $(printf '%s' "$root" | shasum | cut -c1-8)"
# Repo-wide registry (in the shared git dir) of which checkout owns each simulator, so sweep can
# find simulators whose worktree is gone even after that worktree's .verify/ went with it.
registry="$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)/ffive-verify"

die() { echo "ffive-verify: $*" >&2; exit 1; }
log() { echo "ffive-verify: $*" >&2; }

register() { mkdir -p "$registry"; printf 'ROOT=%q\nNAME=%q\n' "$2" "$3" >"$registry/$1"; }

our_simulators() {
    # udid<TAB>name<TAB>state for every simulator named like ours.
    xcrun simctl list devices -j | /usr/bin/python3 -c '
import json, re, sys
for runtime in json.load(sys.stdin)["devices"].values():
    for d in runtime:
        if re.fullmatch(r"FFive Verify [0-9a-f]{8}", d["name"]):
            print(d["udid"], d["name"], d["state"], sep="\t")
'
}

load_state() {
    [[ -f "$state" ]] || die "no instance; run: $0 launch"
    # shellcheck disable=SC1090
    source "$state"
    # park shuts the simulator down between turns; boot it again on first use.
    local dev; dev="$(device_state "$UDID")"
    [[ -n "$dev" ]] || die "simulator $UDID is gone; run: $0 launch"
    if [[ "$(cut -f1 <<<"$dev")" != "Booted" ]]; then
        log "booting parked simulator $UDID"
        xcrun simctl bootstatus "$UDID" -b >/dev/null
    fi
}

device_state() {
    xcrun simctl list devices -j | /usr/bin/python3 -c '
import json, sys
udid = sys.argv[1]
for runtime in json.load(sys.stdin)["devices"].values():
    for device in runtime:
        if device["udid"] == udid:
            print(device["state"], device["name"], sep="\t")
' "$1"
}

source_stamp() {
    # HEAD plus a hash of uncommitted app changes, so doctor can tell a stale install from a current one.
    local head dirty
    head="$(git -C "$root" rev-parse --short HEAD)"
    dirty="$(git -C "$root" diff HEAD -- FFive FFiveCore FFive.xcodeproj | shasum | cut -c1-8)"
    [[ -z "$(git -C "$root" status --porcelain -- FFive FFiveCore FFive.xcodeproj)" ]] && echo "$head" || echo "$head+dirty.$dirty"
}

latest_runtime() {
    xcrun simctl list runtimes -j | /usr/bin/python3 -c '
import json, sys
ios = [r for r in json.load(sys.stdin)["runtimes"] if r["platform"] == "iOS" and r["isAvailable"]]
if not ios: sys.exit("no available iOS runtime")
print(sorted(ios, key=lambda r: [int(p) for p in r["version"].split(".")])[-1]["identifier"])'
}

build_and_install() {
    local udid="$1"
    log "building FFive (log: $work/build-app.log)"
    xcodebuild -project "$root/FFive.xcodeproj" -scheme FFive -destination "id=$udid" \
        -derivedDataPath "$app_build" build >"$work/build-app.log" 2>&1 \
        || { tail -30 "$work/build-app.log" >&2; die "app build failed"; }
    log "building driver (log: $work/build-driver.log)"
    xcodebuild build-for-testing -project "$skill/harness/FFiveDriver.xcodeproj" -scheme FFiveDriver \
        -destination "id=$udid" -derivedDataPath "$driver_build" >"$work/build-driver.log" 2>&1 \
        || { tail -30 "$work/build-driver.log" >&2; die "driver build failed"; }
    xcrun simctl install "$udid" "$app_build/Build/Products/Debug-iphonesimulator/FFive.app"
}

cmd_launch() {
    mkdir -p "$work" "$artifacts"
    # Tells park the simulator is in use while launch builds and installs.
    echo $$ >"$work/launch.pid"
    local udid=""
    if [[ -f "$state" ]]; then
        source "$state"
        udid="$UDID"
    fi
    if [[ -z "$udid" || -z "$(device_state "$udid")" ]]; then
        log "creating simulator \"$device_name\""
        udid="$(xcrun simctl create "$device_name" "$device_type" "$(latest_runtime)")"
    fi
    register "$udid" "$root" "$device_name"
    if [[ "$(device_state "$udid" | cut -f1)" != "Booted" ]]; then
        xcrun simctl boot "$udid"
    fi
    xcrun simctl bootstatus "$udid" -b >/dev/null
    printf 'UDID=%s\nDEVICE_NAME=%q\nSTAMP=%s\n' "$udid" "$device_name" "$(source_stamp)" >"$state"
    build_and_install "$udid"
    log "smoke drive"
    local smoke
    smoke="$(mktemp "$work/smoke.XXXXXX")"
    printf '%s\n' 'launch -seedDemo' 'wait button "Workout" timeout=20' 'wait button "Workout menu"' 'shot ready' >"$smoke"
    cmd_drive "$smoke" --name launch-smoke
    rm -f "$smoke" "$work/launch.pid"
    echo "READY udid=$udid stamp=$(source_stamp)"
}

cmd_doctor() {
    local ok=1
    check() { if eval "$2"; then echo "ok    $1"; else echo "FAIL  $1"; ok=0; fi; }
    [[ -f "$state" ]] || { echo "FAIL  no instance (no $state); run launch"; exit 1; }
    source "$state"
    local dev; dev="$(device_state "$UDID")"
    check "simulator $UDID exists" '[[ -n "$dev" ]]'
    check "simulator is ours (\"$DEVICE_NAME\")" '[[ "$(cut -f2 <<<"$dev")" == "$DEVICE_NAME" ]]'
    check "simulator booted, or parked until the next command ($(cut -f1 <<<"$dev"))" '[[ "$(cut -f1 <<<"$dev")" =~ ^(Booted|Shutdown)$ ]]'
    # Read the bundle off disk: get_app_container fails on a parked (shut down) simulator.
    check "$bundle_id installed" 'ls -d ~/Library/Developer/CoreSimulator/Devices/"$UDID"/data/Containers/Bundle/Application/*/FFive.app >/dev/null 2>&1'
    check "driver built" '[[ -n "$(ls "$driver_build"/Build/Products/*.xctestrun 2>/dev/null)" ]]'
    check "install matches source (installed $STAMP, source $(source_stamp))" '[[ "$STAMP" == "$(source_stamp)" ]]'
    if [[ -d "$work/drive.lock" ]]; then echo "WARN  a drive holds $work/drive.lock (pid $(cat "$work/drive.lock/pid" 2>/dev/null))"; fi
    [[ $ok == 1 ]] && echo "HEALTHY udid=$UDID" || { echo "UNHEALTHY: run launch (rebuilds and reinstalls) or cleanup"; exit 1; }
}

descendants() {
    local child
    for child in $(pgrep -P "$1"); do descendants "$child"; done
    echo "$1"
}

kill_tree() {
    local pids=() pid
    while read -r pid; do pids+=("$pid"); done < <(descendants "$1")
    kill -TERM "${pids[@]}" 2>/dev/null || true
    sleep 1
    kill -KILL "${pids[@]}" 2>/dev/null || true
}

cmd_drive() {
    local steps="" name="drive" piped="" timeout=600
    mkdir -p "$work"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) name="$2"; shift 2 ;;
            --timeout) timeout="$2"; shift 2 ;;
            -) steps="$(mktemp "$work/stdin.XXXXXX")"; piped="$steps"; cat >"$steps"; shift ;;
            *) steps="$1"; shift ;;
        esac
    done
    [[ -n "$steps" && -f "$steps" ]] || die "usage: drive <steps-file|-> [--name <label>] [--timeout <seconds>]"
    local checked; checked="$(mktemp "$work/steps.XXXXXX")"
    trap 'rm -f ${piped:+"$piped"} ${checked:+"$checked"}' RETURN EXIT
    /usr/bin/python3 "$here/steps-preflight.py" "$steps" "$root/FFiveCore/Sources/FFiveCore/A11y.swift" "$checked" || exit 1
    load_state
    mkdir "$work/drive.lock" 2>/dev/null || die "another drive is running (pid $(cat "$work/drive.lock/pid" 2>/dev/null)); never double-drive one simulator"
    echo $$ >"$work/drive.lock/pid"
    trap 'rm -rf "$work/drive.lock" ${piped:+"$piped"} ${checked:+"$checked"}' RETURN EXIT
    local run="$artifacts/$(date +%Y%m%d-%H%M%S)-$name"
    mkdir -p "$run"
    cp "$checked" "$run/steps.txt"
    local status=0 started=$SECONDS tree_at=$((timeout - 10))
    [[ $tree_at -ge 1 ]] || tree_at=1
    # The driver's own terminate() of an app a previous drive left running can hang; simctl's never has.
    xcrun simctl terminate "$UDID" "$bundle_id" 2>/dev/null || true
    TEST_RUNNER_FFIVE_STEPS="$run/steps.txt" TEST_RUNNER_FFIVE_OUT="$run" \
    TEST_RUNNER_FFIVE_STORE="$(store_path)" TEST_RUNNER_FFIVE_DEFAULTS="$(defaults_path)" \
    TEST_RUNNER_FFIVE_DEADLINE="$(( $(date +%s) + tree_at ))" \
        xcodebuild test-without-building -project "$skill/harness/FFiveDriver.xcodeproj" -scheme FFiveDriver \
        -destination "id=$UDID" -derivedDataPath "$driver_build" -resultBundlePath "$run/result.xcresult" \
        >"$run/xcodebuild.log" 2>&1 &
    local pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        if [[ $((SECONDS - started)) -ge $timeout ]]; then
            kill_tree "$pid"
            xcrun simctl terminate "$UDID" com.juanix.FFiveDriver.xctrunner 2>/dev/null || true
            status=124
            break
        fi
        sleep 1
    done
    if [[ $status == 124 ]]; then wait "$pid" 2>/dev/null || true; else wait "$pid" || status=$?; fi
    if [[ $status != 0 ]] && grep -q '^TIMEOUT' "$run/steps.log" 2>/dev/null; then status=124; fi
    if [[ $status == 124 && ! -f "$run/failure.tree.txt" ]]; then
        xcrun simctl io "$UDID" screenshot "$run/failure.png" >/dev/null 2>&1 || true
        echo "no tree: the driver was killed after ${timeout}s (--timeout); see failure.png and steps.log" >"$run/failure.tree.txt"
    fi
    cat "$run/steps.log" 2>/dev/null || { tail -20 "$run/xcodebuild.log"; }
    local took="$((SECONDS - started))s"
    if [[ $status == 0 ]]; then echo "PASS $run ($took)"
    elif [[ $status == 124 ]]; then echo "FAIL $run ($took; timed out, --timeout ${timeout}s; see failure.png, failure.tree.txt, steps.log)"
    else echo "FAIL $run ($took; see failure.png, failure.tree.txt, xcodebuild.log)"; fi
    return $status
}

store_path() {
    local data; data="$(xcrun simctl get_app_container "$UDID" "$bundle_id" data)"
    echo "$data/Library/Application Support/default.store"
}

cmd_store() {
    load_state
    local db; db="$(store_path)"
    [[ -f "$db" ]] || die "no on-disk store yet ($db). -seedDemo launches are in-memory; launch without it and save something first"
    if [[ $# -eq 0 ]]; then
        sqlite3 -readonly "$db" "select name from sqlite_master where type='table' and name like 'Z%' and name not like 'Z\_%' escape '\\' order by name" \
            | while read -r t; do printf '%-28s %s\n' "$t" "$(sqlite3 -readonly "$db" "select count(*) from $t")"; done
    else
        sqlite3 -readonly -header -column "$db" "$*"
    fi
}

defaults_path() {
    echo "$(xcrun simctl get_app_container "$UDID" "$bundle_id" data)/Library/Preferences/$bundle_id.plist"
}

cmd_defaults() {
    load_state
    local plist; plist="$(defaults_path)"
    [[ -f "$plist" ]] && plutil -p "$plist" || echo "{} (no preferences written yet)"
}

cmd_shot() {
    load_state
    local name="${1:-screen}" run
    run="$(ls -dt "$artifacts"/*/ 2>/dev/null | head -1)"
    [[ -n "$run" ]] || { run="$artifacts/$(date +%Y%m%d-%H%M%S)-manual"; mkdir -p "$run"; }
    xcrun simctl io "$UDID" screenshot "${run%/}/$name.png" >/dev/null 2>&1
    echo "${run%/}/$name.png"
}

cmd_reset_data() {
    load_state
    xcrun simctl terminate "$UDID" "$bundle_id" 2>/dev/null || true
    xcrun simctl uninstall "$UDID" "$bundle_id"
    xcrun simctl install "$UDID" "$app_build/Build/Products/Debug-iphonesimulator/FFive.app"
    echo "reinstalled $bundle_id with an empty store and default settings"
}

cmd_cleanup() {
    local purge=0; [[ "${1:-}" == "--purge" ]] && purge=1
    if [[ -f "$state" ]]; then
        source "$state"
        local dev; dev="$(device_state "$UDID")"
        if [[ -n "$dev" && "$(cut -f2 <<<"$dev")" == "$DEVICE_NAME" && "$DEVICE_NAME" == "FFive Verify "* ]]; then
            xcrun simctl shutdown "$UDID" 2>/dev/null || true
            xcrun simctl delete "$UDID"
            rm -f "$registry/$UDID"
            log "deleted simulator $UDID"
        elif [[ -n "$dev" ]]; then
            log "refusing to delete $UDID: it is \"$(cut -f2 <<<"$dev")\", not \"$DEVICE_NAME\""
        fi
        rm -f "$state"
    fi
    rm -rf "$work/drive.lock" "$work/launch.pid" "$work"/smoke.* "$work"/stdin.*
    [[ $purge == 1 ]] && rm -rf "$app_build" "$driver_build" "$work"/build-*.log
    echo "cleaned; evidence kept in $artifacts"
}

idle_min="${FFIVE_PARK_IDLE_MIN:-10}"

# True when a checkout's .verify/ shows a launch, drive or shot in the last $2 minutes.
recently_used() {
    [[ -n "$(find "$1/state.env" "$1/artifacts" "$1"/build-*.log -maxdepth 1 -mmin "-$2" 2>/dev/null | head -1)" ]]
}

pid_alive() { [[ -f "$1" ]] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null; }

# Prints why a checkout's simulator is in use, or nothing when it is idle.
busy_reason() {
    local udid="$1" dir="$2"
    if [[ -d "$dir/drive.lock" ]] && { [[ ! -f "$dir/drive.lock/pid" ]] || pid_alive "$dir/drive.lock/pid"; }; then
        echo "a drive is running"
    elif pid_alive "$dir/launch.pid"; then
        echo "a launch is running"
    elif pgrep -qf "id=$udid"; then
        echo "an xcodebuild targets it"
    fi
}

# Shuts down a booted simulator of ours that nothing is using. Its app, data and builds stay.
park_simulator() {
    local udid="$1" name="$2" dir="$3" dry="${4:-0}" dev why
    dev="$(device_state "$udid")"
    [[ "$(cut -f1 <<<"$dev")" == "Booted" && "$(cut -f2 <<<"$dev")" == "$name" && "$name" == "FFive Verify "* ]] || return 0
    why="$(busy_reason "$udid" "$dir")"
    if [[ -n "$why" ]]; then log "not parking $name ($udid): $why"
    elif [[ $dry == 1 ]]; then log "would park $name ($udid)"
    else xcrun simctl shutdown "$udid" && log "parked $name ($udid)"; fi
}

cmd_park() {
    [[ -f "$state" ]] || return 0
    if [[ "${1:-}" == "--idle" ]]; then recently_used "$work" "$idle_min" && return 0; fi
    # shellcheck disable=SC1090
    source "$state"
    park_simulator "$UDID" "$DEVICE_NAME" "$work"
}

cmd_sweep() {
    # Deletes simulators whose owning checkout no longer exists, and parks booted ones whose checkout
    # has not used them for $idle_min minutes. Never touches a simulator this repo did not create.
    local dry=0; [[ "${1:-}" == "--dry-run" ]] && dry=1
    local live=() path
    while IFS= read -r path; do
        [[ -d "$path" ]] && live+=("$path")
    done < <(git -C "$here" worktree list --porcelain | sed -n 's/^worktree //p')
    is_live() { local p; for p in "${live[@]}"; do [[ "$p" == "$1" ]] && return 0; done; return 1; }

    local udid name _state ROOT NAME p
    while IFS=$'\t' read -r udid name _state; do
        if [[ ! -f "$registry/$udid" ]]; then
            # Created before the registry existed: adopt it if a live checkout hashes to its name.
            for p in "${live[@]}"; do
                if [[ "FFive Verify $(printf '%s' "$p" | shasum | cut -c1-8)" == "$name" ]]; then
                    if [[ $dry == 1 ]]; then log "would adopt $name ($udid) for $p"
                    else register "$udid" "$p" "$name"; log "adopted $name ($udid) for $p"; fi
                    continue 2
                fi
            done
            log "skipping $name ($udid): no record of which checkout made it"
            continue
        fi
        # shellcheck disable=SC1090
        ROOT=""; NAME=""; source "$registry/$udid"
        if is_live "$ROOT"; then
            recently_used "$ROOT/.verify" "$idle_min" || park_simulator "$udid" "$name" "$ROOT/.verify" "$dry"
            continue
        fi
        if [[ "$NAME" != "$name" ]]; then
            log "skipping $udid: registered as \"$NAME\" but now named \"$name\""
            continue
        fi
        if [[ $dry == 1 ]]; then
            log "would delete $name ($udid): $ROOT is gone"
        else
            xcrun simctl shutdown "$udid" 2>/dev/null || true
            xcrun simctl delete "$udid"
            rm -f "$registry/$udid"
            log "deleted $name ($udid): $ROOT is gone"
        fi
    done < <(our_simulators)

    # Drop records of simulators that no longer exist.
    if [[ -d "$registry" && $dry == 0 ]]; then
        local existing; existing="$(our_simulators | cut -f1)"
        for p in "$registry"/*; do
            [[ -f "$p" ]] || continue
            grep -qxF "$(basename "$p")" <<<"$existing" || rm -f "$p"
        done
    fi
}

case "${1:-}" in
    launch) shift; cmd_launch "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    drive) shift; cmd_drive "$@" ;;
    store) shift; cmd_store "$@" ;;
    defaults) shift; cmd_defaults "$@" ;;
    shot) shift; cmd_shot "$@" ;;
    reset-data) shift; cmd_reset_data "$@" ;;
    cleanup) shift; cmd_cleanup "$@" ;;
    park) shift; cmd_park "$@" ;;
    sweep) shift; cmd_sweep "$@" ;;
    *) echo "usage: $0 {launch|doctor|drive <steps|-> [--name n] [--timeout s]|store [sql]|defaults|shot [name]|reset-data|cleanup [--purge]|park [--idle]|sweep [--dry-run]}" >&2; exit 2 ;;
esac
