# settings: switch the weight unit to kilograms, see it in a session, then switch back.
# The unit lives in UserDefaults, which -seedDemo does not isolate: this journey always ends on Pounds.
# defaults-expect reads the stored unit after the last switch to each unit.
launch -seedDemo
tap #tab.more timeout=20
tap #more.settings
wait nav "Settings"
wait text "~Version"
tap #settings.unit.kg
selected #settings.unit.kg
tap #settings.unit.lb
selected #settings.unit.lb
tap #settings.unit.kg
selected #settings.unit.kg
defaults-expect weightUnit kg
shot 01-kilograms
launch -seedDemo
wait text "WEEK 2 DAY 1" timeout=20
wait field "kg"
absent field "lb"
tap #exercise.history.1
wait text "~ kg"
shot 02-session-in-kg
launch -seedDemo
tap #tab.more timeout=20
tap #more.settings
tap #settings.unit.lb
selected #settings.unit.lb
defaults-expect weightUnit lb
