# settings: switch the weight unit to kilograms, see it in a session, then switch back.
# The unit lives in UserDefaults, which -seedDemo does not isolate: this journey always ends on Pounds.
# Check between switches with: ffive-verify defaults
launch -seedDemo
tap button "More" timeout=20
tap button "Settings"
wait nav "Settings"
wait text "~Version, "
tap button "Kilograms (kg)"
selected button "Kilograms (kg)"
tap button "Pounds (lb)"
selected button "Pounds (lb)"
tap button "Kilograms (kg)"
selected button "Kilograms (kg)"
shot 01-kilograms
launch -seedDemo
wait text "WEEK 2 DAY 1" timeout=20
wait field "kg"
absent field "lb"
shot 02-session-in-kg
launch -seedDemo
tap button "More" timeout=20
tap button "Settings"
tap button "Pounds (lb)"
selected button "Pounds (lb)"
