# progress: volume, strength, and history panes on the seeded demo, reached from the More tab.
launch -seedDemo
tap #tab.more timeout=20
tap #more.progress
wait nav "Progress"
selected #segment.volume
wait text "Sets per Muscle*Week 2"
wait any "~Quads, 4 of"
tap #segment.w1
wait text "Sets per Muscle*Week 1"
shot 01-volume-w1
tap #segment.strength
wait text "Estimated 1RM"
tap #strength.row.leg-press
wait nav "Leg Press"
shot 02-strength-trend
tap button "Progress"
tap #segment.history
wait text "All Time"
tap #history.row.morning-workout
wait nav "Morning Workout"
wait text "Bench Press"
shot 03-history-detail
tap button "Progress"
wait #history.row.morning-workout
swipe left #history.row.morning-workout
tap button "Delete"
wait #dialog.delete-workout
wait text "Delete this workout?"
wait text "~Morning Workout leaves History and Progress."
shot 04-delete-confirm
tap any "dismiss popup"
absent #dialog.delete-workout
wait #history.row.morning-workout
swipe left #history.row.morning-workout
tap button "Delete"
tap #dialog.delete-workout
absent #history.row.morning-workout
shot 05-after-delete
