# progress: volume, strength, and history panes on the seeded demo, reached from the More tab.
launch -seedDemo
tap #tab.more timeout=20
tap #more.progress
wait nav "Progress"
selected #segment.volume
wait text "Sets per muscle*Week 2"
wait any "~Quads 4 of"
tap #segment.w1
wait text "Sets per muscle*Week 1"
shot 01-volume-w1
tap #segment.strength
wait text "Estimated 1RM"
tap #strength.row.leg-press
wait nav "Leg Press"
shot 02-strength-trend
tap button "Progress"
tap #segment.history
wait text "All Time"
tap #history.row.morning-workout
wait nav "Morning Workout"
wait text "Bench Press"
shot 03-history-detail
