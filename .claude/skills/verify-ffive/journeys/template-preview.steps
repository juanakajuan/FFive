launch
tap #tab.templates timeout=20
tap #templates.template.upper-lower-4-days
wait nav "Upper*4 Days"
selected #template-preview.day.1
shot builtin-day1
tap #template-preview.day.3
selected #template-preview.day.3
shot builtin-day3
scrollto text "Muscle Focus"
shot builtin-focus
tap #template-preview.plan
wait nav "Customize"
value #builder.name "Upper/Lower, 4 Days"
tap #builder.menu
tap #builder.save-template
wait alert "Save as Template"
replace field "Template name" "My Split"
sleep 1
tap button "Save"
absent alert "Save as Template"
store-expect CustomTemplate name "My Split"
tap #builder.cancel
wait nav "Upper*4 Days"
tap button "BackButton"
tap #templates.custom.my-split
wait nav "My Split"
shot custom-preview
tap #template-preview.menu
tap #menu.edit-template
wait nav "Edit Template"
absent #builder.name
absent #builder.start
shot custom-edit
tap button "Remove Day" timeout=5
tap #builder.update-template
wait nav "My Split"
wait #template-preview.day.3
absent #template-preview.day.4
shot custom-after-edit
tap #template-preview.menu
tap #menu.rename-template
wait alert "Rename Template"
replace field "Template name" "Three Day Split"
sleep 1
tap button "Save"
absent alert "Rename Template"
wait nav "Three Day Split"
store-expect CustomTemplate name "Three Day Split"
tap #template-preview.plan
wait nav "Customize"
value #builder.name "Three Day Split"
shot custom-plan
tap #builder.cancel
wait nav "Three Day Split"
tap #template-preview.menu
tap #menu.delete-template
tap #dialog.delete-template
wait text "Your templates"
absent #templates.custom.three-day-split
shot custom-deleted
launch
tap #tab.templates timeout=20
wait text "Your templates"
absent #templates.custom.three-day-split
