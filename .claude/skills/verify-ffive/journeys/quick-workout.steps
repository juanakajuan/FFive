# quick-workout: log a free-form session with no mesocycle, on-disk.
# Before: ffive-verify reset-data (no active mesocycle, so the Workout tab shows its empty state).
# After: ffive-verify store "select w.ZNAME, w.ZENDDATE is not null as finished, e.ZNAME as exercise, s.ZWEIGHT, s.ZREPS, s.ZISDONE from ZWORKOUT w join ZEXERCISE e on e.ZWORKOUT = w.Z_PK join ZSETENTRY s on s.ZEXERCISE = e.Z_PK where w.ZMESOCYCLE is null"
launch
wait #workout.quick timeout=20
tap #workout.quick
wait text "QUICK WORKOUT"
tap #workout.menu
tap #menu.add-exercise
wait nav "Add Exercise"
type #picker.search "Lateral"
tap #picker.row.lateral-raise
wait text "Lateral Raise"
replace #set.weight.1 "25"
replace #set.reps.1 "12"
value #set.weight.1 "25"
value #set.reps.1 "12"
tap #keyboard.done
absent #workout.finish
shot 01-finish-hidden-until-logged
tap #set.log.1
selected #set.log.1
wait #workout.finish
shot 02-logged-set
tap #workout.finish
wait text "All Time" timeout=10
store-expect SetEntry weight 25
store-expect SetEntry reps 12
store-expect SetEntry isDone 1
store-expect Workout endDate not-null
wait #workout.quick
tree 03-workout-after-finish
shot 03-workout-after-finish
tap #tab.more
tap #more.progress
tap #segment.history
# A bare "~Workout" would match the Workout tab button first.
tap button "~Workout,"
wait text "Lateral Raise"
shot 04-history-detail
