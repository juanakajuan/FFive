# plan-mesocycle: plan a block from a template on an empty, on-disk store.
# Before: ffive-verify reset-data. After: ffive-verify store "select ZNAME, ZACCUMULATIONWEEKS from ZMESOCYCLE"
launch
wait #workout.plan timeout=20
shot 01-empty-workout
tap #workout.plan
wait nav "New Mesocycle"
tap #builder.template.upper-lower-4-days
wait nav "Customize"
replace #builder.name "Verify Block"
tap button "~Increment"
wait any "5 training weeks, then 1 deload week"
shot 02-customized
tap #builder.start
wait text "WEEK 1 DAY 1" timeout=10
store-expect Mesocycle name "Verify Block"
store-expect Mesocycle accumulationWeeks 5
wait text "~Verify Block"
shot 03-session
tap #tab.mesos
wait text "Verify Block"
wait text "~6 WEEKS"
shot 04-mesos
launch
wait text "WEEK 1 DAY 1" timeout=20
wait text "~Verify Block"
shot 05-after-relaunch
