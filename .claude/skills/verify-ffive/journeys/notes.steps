# notes: an exercise note stays on its workout until pinned; a pinned note carries forward, edits, unpins, and deletes. A day note shows in history. On-disk.
# Before: ffive-verify reset-data (no active mesocycle).
# After: ffive-verify store "select ZNAME, ZTEXT from ZPINNEDNOTE", "select ZNAME, ZNOTE from ZEXERCISE", and "select ZNAME, ZNOTE from ZWORKOUT"
launch
wait #workout.quick timeout=20
tap #workout.quick
wait text "QUICK WORKOUT"
tap #workout.menu
tap #menu.add-exercise
wait nav "Add Exercise"
type #picker.search "Lateral"
tap #picker.row.lateral-raise
wait text "Lateral Raise"
tap #exercise.menu.1
wait #menu.exercise-note
tap #menu.exercise-note
wait nav "Exercise Note"
type #note.text "Seat Level: 4"
tap #note.save
wait any "Note: Seat Level: 4"
wait button "Pin note"
shot 01-unpinned-note-on-card
tap #workout.menu
wait #menu.workout-note
tap #menu.workout-note
wait nav "Workout Note"
type #note.text "Gym was busy"
tap #note.save
wait any "Workout note: Gym was busy"
shot 02-day-note-in-session
replace #set.weight.1 "25"
replace #set.reps.1 "12"
tap #keyboard.done
tap #set.log.1
wait #workout.finish
tap #workout.finish
wait text "All Time" timeout=10
store-expect Workout note "Gym was busy"
# Relaunch proves both notes reached the store.
launch
wait #workout.quick timeout=20
tap #tab.more
tap #more.progress
tap #segment.history
tap button "~Workout,"
wait any "Workout note: Gym was busy"
wait any "Note: Seat Level: 4"
shot 03-notes-in-workout-detail
tap #tab.workout
wait #workout.quick
tap #workout.quick
wait text "QUICK WORKOUT"
tap #workout.menu
tap #menu.add-exercise
wait nav "Add Exercise"
type #picker.search "Lateral"
tap #picker.row.lateral-raise
wait text "Lateral Raise"
absent any "~Note: Seat Level"
shot 04-unpinned-note-not-carried
tap #exercise.menu.1
wait #menu.exercise-note
tap #menu.exercise-note
wait nav "Exercise Note"
type #note.text "Seat Level: 5"
tap #note.save
wait any "Note: Seat Level: 5"
tap #exercise.pin.1
wait button "Unpin note"
store-expect PinnedNote text "Seat Level: 5"
shot 05-note-pinned
replace #set.weight.1 "25"
replace #set.reps.1 "12"
tap #keyboard.done
tap #set.log.1
wait #workout.finish
tap #workout.finish
wait text "All Time" timeout=10
launch
wait #workout.quick timeout=20
tap #tab.exercises
wait text "Exercises"
type #exercises.search "Lateral Raise"
tap #exercises.row.lateral-raise
wait any "Note: Seat Level: 5"
shot 06-pinned-note-in-exercise-detail
tap #tab.workout
wait #workout.quick
tap #workout.quick
wait text "QUICK WORKOUT"
tap #workout.menu
tap #menu.add-exercise
wait nav "Add Exercise"
type #picker.search "Lateral"
tap #picker.row.lateral-raise
wait any "Note: Seat Level: 5"
wait button "Unpin note"
shot 07-pinned-note-carried
tap #exercise.menu.1
wait #menu.exercise-note
tap #menu.exercise-note
wait nav "Exercise Note"
replace #note.text "Seat Level: 6"
tap #note.save
wait any "Note: Seat Level: 6"
wait button "Unpin note"
tap #exercise.pin.1
wait button "Pin note"
wait any "Note: Seat Level: 6"
shot 08-unpinned-note-stays-on-workout
tap #exercise.menu.1
wait #menu.delete-note
tap #menu.delete-note
absent any "~Note: Seat Level"
shot 09-note-deleted
# An immediate relaunch proves the unpin and delete were saved, not left to autosave.
launch
wait text "QUICK WORKOUT" timeout=20
absent any "~Note: Seat Level"
