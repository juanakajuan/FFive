# notes: add, carry forward, edit, and delete an exercise note, and add a day note, on-disk.
# Before: ffive-verify reset-data (no active mesocycle).
# After: ffive-verify store "select ZNAME, ZTEXT from ZEXERCISENOTE" and "select ZNAME, ZNOTE from ZWORKOUT"
launch
wait button "Quick Workout" timeout=20
tap button "Quick Workout"
wait text "QUICK WORKOUT"
tap button "Workout menu"
tap button "Add Exercise"
wait nav "Add Exercise"
type search "Search or create exercise" "Lateral"
tap button "Lateral Raise, Dumbbell"
wait text "Lateral Raise"
tap button "Exercise menu"
wait button "Add Note"
tap button "Add Note"
wait nav "Exercise Note"
type field "Note" "Seat Level: 4"
tap button "Save"
wait any "Note: Seat Level: 4"
shot 01-exercise-note-on-card
tap button "Workout menu"
wait button "Add Note"
tap button "Add Note"
wait nav "Workout Note"
type field "Note" "Gym was busy"
tap button "Save"
wait any "Workout note: Gym was busy"
shot 02-day-note-in-session
replace field "Set 1 weight" "25"
replace field "Set 1 reps" "12"
tap button "Done"
tap button "Log set 1"
wait button "Finish Workout"
tap button "Finish Workout"
wait text "All Time" timeout=10
# Relaunch proves both notes reached the store.
launch
wait button "Quick Workout" timeout=20
tap button "More"
tap button "Progress"
tap button "History"
tap button "~Workout,"
wait any "Workout note: Gym was busy"
shot 03-day-note-in-workout-detail
tap button "Workout"
wait button "Quick Workout"
tap button "Quick Workout"
wait text "QUICK WORKOUT"
tap button "Workout menu"
tap button "Add Exercise"
wait nav "Add Exercise"
type search "Search or create exercise" "Lateral"
tap button "Lateral Raise, Dumbbell"
wait any "Note: Seat Level: 4"
shot 04-note-carried-to-next-workout
tap button "Exercise menu"
wait button "Edit Note"
tap button "Edit Note"
wait nav "Exercise Note"
replace field "Note" "Seat Level: 5"
tap button "Save"
wait any "Note: Seat Level: 5"
absent any "Note: Seat Level: 4"
shot 05-note-edited
tap button "Exercises"
wait text "Exercises"
type field "Search" "Lateral Raise"
tap button "Lateral Raise, Side Delts, •, Dumbbell"
wait any "Note: Seat Level: 5"
shot 06-note-in-exercise-detail
tap button "Workout"
wait text "QUICK WORKOUT"
tap button "Exercise menu"
wait button "Delete Note"
tap button "Delete Note"
absent any "Note: Seat Level: 5"
shot 07-note-deleted
# An immediate relaunch proves the delete was saved, not left to autosave.
launch
wait text "QUICK WORKOUT" timeout=20
absent any "~Note: Seat Level"
