#!/bin/sh
cd "$(dirname "$0")/.." || exit 1
out="$(mktemp)"
trap 'rm -f "$out"' EXIT

run() {
    started=$(date +%s)
    if "scripts/$1" $2 > "$out" 2>&1; then
        echo "ok   $* ($(($(date +%s) - started))s) $(tail -n 1 "$out")"
    else
        cat "$out"
        echo "CHECK FAIL $*"
        exit 1
    fi
}

run lint.sh --self-test
run lint.sh
run typecheck-app.sh
run check-engine.sh
run check-planner.sh
run perf-probe.sh
echo "CHECK PASS"
